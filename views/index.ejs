<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Task App</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-zinc-900 min-h-screen text-white">

  <div class="max-w-6xl mx-auto p-10">

    <!-- Form -->
    <div class="mb-12">
      <form action="/create" method="post" class="space-y-4">
        
        <input 
          type="text" 
          name="title"
          placeholder="Title goes here..."
          required
          class="w-full p-3 rounded-md bg-zinc-800 outline-none focus:ring-2 focus:ring-blue-600"
        >

        <textarea 
          name="details"
          placeholder="Write your task details here..."
          required
          class="w-full p-3 rounded-md bg-zinc-800 outline-none focus:ring-2 focus:ring-blue-600"
        ></textarea>

        <button 
          class="bg-blue-600 hover:bg-blue-700 transition px-5 py-2 rounded-md">
          Create Task
        </button>

      </form>
    </div>

    <!-- Tasks -->
    <% if (files.length > 0) { %>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">

        <% files.forEach(function(val) { %>

          <div class="bg-zinc-800 rounded-xl p-5 shadow-md hover:shadow-lg transition duration-200 flex flex-col justify-between h-48 border border-zinc-700">

            <!-- Title + Read -->
            <div>
              <h2 class="text-lg font-semibold truncate">
                <%= val %>
              </h2>

              <a 
                href="/file/<%= val %>" 
                class="text-blue-400 text-sm mt-2 inline-block hover:underline">
                Read More
              </a>
            </div>

            <!-- Actions -->
            <div class="flex justify-between items-center mt-4 text-sm">
              
              <a 
                href="/edit/<%= val %>" 
                class="text-green-400 hover:text-green-300">
                Edit
              </a>

              <form 
                action="/delete/<%= val %>" 
                method="post"
                onsubmit="return confirm('Delete this task?')">
                
                <button 
                  type="submit" 
                  class="text-red-400 hover:text-red-300">
                  Delete
                </button>

              </form>

            </div>

          </div>

        <% }) %>

      </div>

    <% } else { %>

      <h3 class="text-zinc-500 text-center mt-10">
        No tasks yet.
      </h3>

    <% } %>

  </div>

</body>
</html>
